# Copy to .env for local runs. In GitHub, these become repository
# variables (the non-secret ones) and repository secrets.

# ---- non-secret: set these as repository *variables* ----
CF_YEAR=2026
CF_DIVISIONS=1,2
# Public https base where chart images will live. Email clients fetch these
# anonymously, so it must work without a login.
ASSET_BASE=https://raw.githubusercontent.com/YOURNAME/splitline-engine/main/posts
# Adds a buy button to the bottom of every post once the product is listed.
SPLITLINE_PRODUCT_URL=
# Only turn this on with a beehiiv Max or Enterprise plan.
BEEHIIV_AUTOPOST=false
BEEHIIV_STATUS=draft

# ---- secret: set these as repository *secrets* ----
BEEHIIV_PUB_ID=pub_385f736e-c99e-4e63-80ad-46fa8a31d552
BEEHIIV_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=splitlinehq@gmail.com
SMTP_PASS=
NOTIFY_EMAIL=splitlinehq@gmail.com

# ---- editorial gate (defaults are sensible; raise to be stricter) ----
MIN_SAMPLE=500
MIN_EFFECT=0.08
